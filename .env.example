# ═══════════════════════════════════════════════════════════════════
# Specter Configuration & Integrations (.env)
# ═══════════════════════════════════════════════════════════════════

# Google Sheets Webhook Deployment URL (Apps Script /exec)
SPECTER_SHEETS_WEBHOOK=""

# GitHub Personal Access Tokens (comma-separated for multi-token rotation & 5,000 req/hr rate limits)
# Create a classic token at https://github.com/settings/tokens (no special scopes needed for public repo OSINT)
GITHUB_TOKENS=""

# Your skill profile (comma-separated) used for job match scoring
MY_SKILLS="Go, Python, PostgreSQL, Redis, Kubernetes, Distributed Systems"

# Autonomous Crawler & Mining Pacing
SPECTER_CONCURRENCY=4
SPECTER_MAX_REPOS=15
SPECTER_MAX_COMMITS=35
SPECTER_CRAWL_TTL_DAYS=3

# Default Output Directory for dossiers and markdown reports
SPECTER_OUTPUT_DIR="reports"
